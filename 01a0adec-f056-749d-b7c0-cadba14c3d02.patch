+#define VDP2_N1ZMHF ((zmctl & 0x0100) >> 8)
+#define VDP2_N0ZMQT ((zmctl & 0x0002) >> 1)
+#define VDP2_N0ZMHF ((zmctl & 0x0001) >> 0)
+// FUNCTIONS
+static void put(saturn_state &s, unsigned bank, unsigned timing, unsigned command) {
+  unsigned const reg = 0x010 / 2 + bank * 2 + timing / 4;
+  unsigned const shift = 12 - 4 * (timing % 4);
+  s.m_vdp2_regs[reg] = uint16_t((s.m_vdp2_regs[reg] & ~(15u << shift)) | (command << shift));
+}
+int main() {
+  saturn_state s;
+  unsigned cases = 0;
+  // 1. Programmed command decode, including T4-T7 indexing of the upper word.
+  for (unsigned bank = 0; bank < 4; ++bank)
+    for (unsigned timing = 0; timing < 8; ++timing)
+      for (unsigned command = 0; command < 16; ++command) {
+        s.m_vdp2_regs.fill(0xffff);
+        put(s, bank, timing, command);
+        s.ramctl = 0x300; // both halves partitioned: each bank owns a register
+        s.bgon = 0x0f;    // every normal screen displayed, no rotation
+        s.vdp2_prepare_vram_access();
+        assert(s.vdp2_cycle_command(bank, timing) == command);
+        assert(s.vdp2_cycle_effective_command(bank, timing) == command);
+        ++cases;
+      }
+  std::cout << cases << " command-decode cases ok\n";
+  // 2. Disabled-screen substitution (ST-058 printed p.36): a pattern-name or
+  // character/bitmap command of a screen that is not displayed becomes CPU
+  // read/write; CPU and no-access commands keep their value.
+  for (unsigned layer = 0; layer < 4; ++layer)
+    for (unsigned kind = 0; kind < 2; ++kind) {
+      unsigned const command = kind ? layer + 4 : layer;
+      for (unsigned displayed = 0; displayed < 2; ++displayed) {
+        s.m_vdp2_regs.fill(0xffff);
+        put(s, 0, layer, command);
+        s.bgon = displayed ? (1U << layer) : 0;
+        s.ramctl = 0;
+        s.vdp2_prepare_vram_access();
+        unsigned const expect = displayed ? command : 0xe;
+        assert(s.vdp2_cycle_command(0, layer) == command);
+        assert(s.vdp2_cycle_effective_command(0, layer) == expect);
+        ++cases;
+      }
+    }
+  // Two enabled rotation screens exclude every normal screen (p.148); RBG1
+  // takes over NBG0's display slot (p.25).
+  s.m_vdp2_regs.fill(0xffff);
+  put(s, 0, 0, 0x0);
+  s.ramctl = 0;
+  s.bgon = 0x31;
+  s.vdp2_prepare_vram_access();
+  assert(s.vdp2_cycle_effective_command(0, 0) == 0xe);
+  s.bgon = 0x21;
+  s.vdp2_prepare_vram_access();
+  assert(s.vdp2_cycle_effective_command(0, 0) == 0xe);
+  ++cases;
+  // 3. Rotation-owned banks execute no normal commands and offer no CPU timing.
+  s.m_vdp2_regs.fill(0xffff);
+  put(s, 0, 0, 0x0);
+  put(s, 1, 0, 0x0);
+  put(s, 2, 0, 0x0);
+  put(s, 3, 0, 0x0);
+  s.bgon = 0x11; // R0ON, NBG0 off
+  s.ramctl = 0x0001 | 0x300; // R0 owns A0
+  s.vdp2_prepare_vram_access();
