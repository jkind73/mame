--- /dev/null
+++ b/regtests/saturn/run_state_roundtrip.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""Real MAME save-manager round trip with frame equality.
+
+Runs a linked MAME three times on the same system:
+
+  1. reference run to ``--total-seconds`` (no state involved),
+  2. save run to ``--save-seconds`` with ``-autosave``, which makes MAME write
+     ``<state_directory>/<statename>/auto.sta`` on exit,
+  3. load run to ``--total-seconds`` with ``-autosave``, which loads that state
+     at startup and continues from the saved emulated time.
+
+Each run records an AVI. The load run's frames must be a contiguous, exactly
+equal slice of the reference run's frames, and its first frame must be the
+reference frame nearest the save time. Byte equality of the whole frame means
+VDP1 framebuffer/drawing state, VDP2 composition, CRAM, scroll/rotation and the
+raster position all survived the save/load round trip.
+
+Unlike ``run_vdp2_runtime.py`` this needs no Lua, so it works in builds where
+the Lua engine is unavailable; it also does not depend on game ROMs.
+
+Requires a linked executable (``make SUBTARGET=saturn ...``) and the user's own
+BIOS ROM set. Not part of ``run_all.py``. This proves state restoration, not
+hardware accuracy.
+"""
+
+import argparse
+import os
+import struct
+import subprocess
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+
+
+def run_mame(exe, system, rompath, outdir, seconds, avi, autosave, timeout):
+    outdir.mkdir(parents=True, exist_ok=True)
+    # The plugin bootstrap is a Lua script; a build whose Lua engine cannot load
+    # MAME's plugin modules aborts the run unless plugins are switched off in an
+    # ini file found from the working directory.
+    ini = outdir / 'mame.ini'
+    if not ini.exists():
+        ini.write_text('plugins 0\n')
+    command = [
+        str(exe), system, '-rompath', str(rompath), '-skip_gameinfo', '-nodrc',
+        '-sound', 'none', '-nothrottle', '-video', 'soft', '-window',
+        '-seconds_to_run', str(seconds), '-aviwrite', str(avi),
+        '-nvram_directory', str(outdir / 'nvram'),
+        '-cfg_directory', str(outdir / 'cfg'),
+        '-state_directory', str(outdir / 'state'),
+        '-snapshot_directory', str(outdir / 'snap'),
+    ]
+    if autosave:
+        command.append('-autosave')
+    env = dict(os.environ, SDL_VIDEODRIVER='offscreen')
+    log = outdir / (avi.stem + '.log')
+    with log.open('w') as handle:
+        subprocess.run(command, stdout=handle, stderr=subprocess.STDOUT,
+                       env=env, cwd=str(outdir), check=True, timeout=timeout)
+    if not avi.exists():
+        raise SystemExit(f'no AVI produced: {avi} (see {log})')
+
+
+def avi_frames(path):
+    """Return the uncompressed 24-bit frames of an AVI written by MAME."""
+    data = path.read_bytes()
+    if data[:4] != b'RIFF' or data[8:12] != b'AVI ':
+        raise SystemExit(f'{path} is not an AVI')
+    pos = data.find(b'movi')
+    if pos < 0:
+        raise SystemExit(f'{path} has no movi list')
+    frames = []
+    index = pos + 4
+    while index + 8 <= len(data):
+        chunk = data[index:index + 4]
+        size = struct.unpack('<I', data[index + 4:index + 8])[0]
+        if chunk == b'00db':
+            frames.append(data[index + 8:index + 8 + size])
+        index += 8 + size + (size & 1)
+    if not frames:
+        raise SystemExit(f'{path} contains no video frames')
+    return frames
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('--executable', required=True)
+    parser.add_argument('--rompath', required=True)
+    parser.add_argument('--output', required=True)
+    parser.add_argument('--system', default='saturnjp')
+    parser.add_argument('--save-seconds', type=int, default=12)
+    parser.add_argument('--total-seconds', type=int, default=15)
+    parser.add_argument('--timeout', type=int, default=900)
+    args = parser.parse_args()
+
+    if args.save_seconds >= args.total_seconds:
+        raise SystemExit('--save-seconds must be below --total-seconds')
+
+    exe = Path(args.executable).resolve()
+    out = Path(args.output)
+    out.mkdir(parents=True, exist_ok=True)
+    state_dir = out / 'state'
+
+    # A missing state must not confuse the round trip: start clean, but keep
+    # nvram (the BIOS clock and settings are host-derived and would otherwise
+    # differ between runs for reasons unrelated to the state).
+    reference_avi = out / 'reference.avi'
+    run_mame(exe, args.system, args.rompath, out, args.total_seconds,
+             reference_avi, False, args.timeout)
+
+    save_avi = out / 'save.avi'
+    run_mame(exe, args.system, args.rompath, out, args.save_seconds,
+             save_avi, True, args.timeout)
+    states = sorted(state_dir.rglob('auto.sta'))
+    if not states:
+        raise SystemExit(
+            'no auto.sta was written: the system does not support save states '
+            '(needs MACHINE_SUPPORTS_SAVE) or the save was refused')
+    saved_state = states[0]
+
+    load_avi = out / 'load.avi'
+    run_mame(exe, args.system, args.rompath, out, args.total_seconds,
+             load_avi, True, args.timeout)
+
+    reference = avi_frames(reference_avi)
+    loaded = avi_frames(load_avi)
+    if len(loaded) > len(reference):
+        raise SystemExit('the loading run produced more frames than the reference')
+
+    matches = [offset for offset in range(len(reference) - len(loaded) + 1)
+               if loaded == reference[offset:offset + len(loaded)]]
+    if not matches:
+        differing = sum(1 for a, b in zip(loaded, reference)
+                        if a != b)
+        raise SystemExit(
+            f'FAIL: the loaded run does not reproduce the reference frames '
+            f'({differing} of the first {len(loaded)} frames differ, '
+            f'state {saved_state.name})')
+    if len(matches) > 1:
+        print(f'note: {len(matches)} identical slices (static screen); '
+              f'using offset {matches[0]}')
+
+    offset = matches[0]
+    expected = round(offset / max(len(reference), 1) * args.total_seconds, 3)
+    print(f'STATE_RUNTIME PASS system={args.system} state={saved_state} '
+          f'frames={len(loaded)} reference_offset={offset} '
+          f'~{expected:.1f}s of {args.total_seconds}s '
+          f'identical_full_frames={len(loaded)}')
+
+
+if __name__ == '__main__':
+    sys.exit(main())
