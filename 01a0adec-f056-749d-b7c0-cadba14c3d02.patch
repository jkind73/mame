+#!/usr/bin/env python3
+# license:BSD-3-Clause
+# copyright-holders:MAMEdev Team
+"""Production VDP2 VRAM cycle-pattern model: effective access commands, the
+documented access-count tables and the CPU/DMA grant wait.
+
+Extracts the real helpers from saturn.cpp and drives them with stand-ins for the
+CRTC, screen and CPU clock. This is not a bus-arbiter oracle: it checks the
+published access-command mapping, the timing phase, the documented "auxiliary
+work RAM" case and the computed wait, not MAME's scheduler, SH-2 restartability
+or an actual SCU DMA transfer.
+"""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+p = argparse.ArgumentParser(description=__doc__)
+p.add_argument('--mutation', choices=('mapping', 'timings', 'both-banks', 'posted',
+                                      'idle-rule', 'blanking', 'rotate'))
+a = p.parse_args()
+
+src = (ROOT / 'src/mame/sega/saturn.cpp').read_text()
+
+
+def extract(sig, text):
+    start = text.index(sig)
+    end = text.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[start:end]
+
+
+signatures = [
+    'bool saturn_state::vdp2_normal_screen_displayed(',
+    'uint16_t saturn_state::vdp2_cycle_pattern_register(',
+    'unsigned saturn_state::vdp2_cycle_timing_count(',
+    'unsigned saturn_state::vdp2_cycle_timing_at_dot(',
+    'uint8_t saturn_state::vdp2_cycle_command(',
+    'uint8_t saturn_state::vdp2_cycle_effective_command(',
+    'unsigned saturn_state::vdp2_cycle_slot_count(',
+    'void saturn_state::vdp2_prepare_vram_access(',
+    'int saturn_state::vdp2_next_cpu_timing(',
+    'unsigned saturn_state::vdp2_screen_accesses_per_cycle(',
+    'unsigned saturn_state::vdp2_cpu_vram_wait(',
+]
+body = '\n'.join(extract(sig, src) for sig in signatures)
+original = body
+
+if a.mutation == 'mapping':
+    # Forget the disabled-screen -> CPU read/write substitution.
+    body = body.replace('mapped = VDP2_ACCESS_CPU;', 'mapped = command;')
+if a.mutation == 'timings':
+    # Pretend the wide modes also use eight access timings.
+    body = body.replace('return (m_vdp2->get_hreso() & 6) ? 4 : 8;', 'return 8;')
+if a.mutation == 'both-banks':
+    # Grant a partitioned access with the command in only one bank of the half.
+    body = body.replace('for (unsigned member = (bank & ~1U); member <= (bank | 1U); ++member) {',
+                        'for (unsigned member = bank; member <= bank; ++member) {')
+if a.mutation == 'posted':
+    # Charge the CPU for a posted two-word write as well.
+    body = body.replace('if (posted_write || !m_vdp2->get_disp() || m_vdp2->get_vblank())',
+                        'if ((posted_write && false) || !m_vdp2->get_disp() || m_vdp2->get_vblank())')
+if a.mutation == 'idle-rule':
+    # Drop the documented always-allowed case for an unpartitioned VRAM.
+    body = body.replace('    if (idle)\n      return 0;', '    if (idle)\n      return -1;')
+if a.mutation == 'blanking':
+    # Keep charging waits while the display is disabled.
+    body = body.replace('if (posted_write || !m_vdp2->get_disp() || m_vdp2->get_vblank())',
