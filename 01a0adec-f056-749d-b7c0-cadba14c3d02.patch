+#define VDP2_RAMCTL ramctl
+#define VDP2_BGON bgon
+#define VDP2_CHCTLA chctla
+#define VDP2_CHCTLB chctlb
+#define VDP2_ZMCTL zmctl
+#define VDP2_CYCA0L m_vdp2_regs[0x010 / 2]
+#define VDP2_CYCA0U m_vdp2_regs[0x012 / 2]
+#define VDP2_CYCA1L m_vdp2_regs[0x014 / 2]
+#define VDP2_CYCA1U m_vdp2_regs[0x016 / 2]
+#define VDP2_CYCA2L m_vdp2_regs[0x018 / 2]
+#define VDP2_CYCA2U m_vdp2_regs[0x01a / 2]
+#define VDP2_CYCA3L m_vdp2_regs[0x01c / 2]
+#define VDP2_CYCA3U m_vdp2_regs[0x01e / 2]
+#define VDP2_R0ON ((bgon & 0x0010) >> 4)
+#define VDP2_R1ON ((bgon & 0x0020) >> 5)
+#define VDP2_N0ON ((bgon & 0x0001) >> 0)
+#define VDP2_N1ON ((bgon & 0x0002) >> 1)
+#define VDP2_N2ON ((bgon & 0x0004) >> 2)
+#define VDP2_N3ON ((bgon & 0x0008) >> 3)
+#define VDP2_N0CHCN ((chctla & 0x0070) >> 4)
+#define VDP2_N1CHCN ((chctla & 0x3000) >> 12)
+#define VDP2_N3CHCN ((chctlb & 0x0020) >> 5)
+#define VDP2_N2CHCN ((chctlb & 0x0002) >> 1)
