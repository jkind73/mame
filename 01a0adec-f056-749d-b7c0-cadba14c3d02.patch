+
+uint8_t saturn_state::vdp2_cycle_effective_command(unsigned bank, unsigned timing) const {
+  if (bank >= VDP2_BANK_COUNT || timing >= vdp2_cycle_timing_count())
+    return VDP2_ACCESS_NONE;
