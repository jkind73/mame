 uint32_t saturn_bram_device::read_ext_bram(offs_t offset)
 {
 	if (offset < m_ext_bram.size()/2)
 		return (m_ext_bram[offset * 2] << 16) | m_ext_bram[offset * 2 + 1];
-	else
