+    s.chctla = 0x0040; // NBG0 16.77M colours
+    assert(s.vdp2_screen_accesses_per_cycle(0, false) == 8);
+    s.chctla = 0x1000; // NBG1 256 colours
+    assert(s.vdp2_screen_accesses_per_cycle(1, false) == 2);
+    s.chctla = 0x3000; // NBG1 32768 colours
+    assert(s.vdp2_screen_accesses_per_cycle(1, false) == 4);
