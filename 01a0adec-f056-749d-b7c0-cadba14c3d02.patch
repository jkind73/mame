+    unsigned const pn[3] = {1, 2, 4};
+    unsigned const cp16[3] = {1, 2, 4};
+    unsigned const cp256[2] = {2, 4};
+    for (unsigned r = 0; r < 3; ++r) {
+      s.zmctl = r == 0 ? 0 : r == 1 ? 0x0101 : 0x0202;
+      s.chctla = 0;
+      s.chctlb = 0;
+      assert(s.vdp2_screen_accesses_per_cycle(0, true) == pn[r]);
+      assert(s.vdp2_screen_accesses_per_cycle(1, true) == pn[r]);
+      assert(s.vdp2_screen_accesses_per_cycle(2, true) == 1);
+      assert(s.vdp2_screen_accesses_per_cycle(0, false) == cp16[r]);
+      assert(s.vdp2_screen_accesses_per_cycle(1, false) == cp16[r]);
+      ++cases;
+    }
+    for (unsigned r = 0; r < 2; ++r) {
